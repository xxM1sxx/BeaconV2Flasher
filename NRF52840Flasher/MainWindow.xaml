<Window x:Class="BeaconV2Flasher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NRF52840 Flasher"
        Icon="Assets/NRF52840 Flasher Pixel Icon.ico"
        Width="900"
        Height="720"
        MinWidth="720"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="36,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="NRF52840 Flasher"
                       FontFamily="Segoe UI Semibold"
                       FontSize="28" />
            <TextBlock Text="oleh Qimtronics"
                       Margin="0,6,0,0"
                       FontSize="14"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,18"
                Padding="24"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="ST-Link"
                           FontFamily="Segoe UI Semibold"
                           FontSize="13" />
                <Grid Grid.Row="1" Margin="0,8,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="StLinkComboBox"
                              MinHeight="42"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="StLinkComboBox_SelectionChanged"
                              AutomationProperties.Name="ST-Link yang digunakan" />
                    <Button x:Name="RefreshButton"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            MinWidth="120"
                            Padding="30,14"
                            Content="Refresh"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="RefreshButton_Click"
                            AutomationProperties.Name="Refresh daftar ST-Link" />
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="Firmware"
                           FontFamily="Segoe UI Semibold"
                           FontSize="13" />
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FirmwarePathTextBox"
                             MinHeight="42"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             ToolTip="Pilih file merged.hex"
                             AutomationProperties.Name="File firmware terpilih" />
                    <Button x:Name="BrowseButton"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            MinWidth="120"
                            Padding="30,14"
                            Content="Pilih file"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseButton_Click"
                            AutomationProperties.Name="Pilih file merged hex" />
                </Grid>

                <CheckBox x:Name="ChipEraseCheckBox"
                          Grid.Row="4"
                          Margin="0,16,0,0"
                          Content="Chip erase sebelum flash"
                          FontSize="14"
                          ToolTip="Menghapus seluruh isi flash termasuk NVS, lalu mem-flash ulang dari merged.hex"
                          AutomationProperties.Name="Chip erase sebelum flash" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="24"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusIndicator"
                                     Width="9"
                                     Height="9"
                                     Margin="0,0,9,0"
                                     Fill="#98A2B3" />
                            <TextBlock x:Name="StatusTextBlock"
                                       Text="Siap"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="15" />
                        </StackPanel>
                        <ProgressBar x:Name="FlashProgressBar"
                                     Width="260"
                                     Height="4"
                                     Margin="0,12,0,0"
                                     HorizontalAlignment="Left"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed" />
                    </StackPanel>
                    <Button x:Name="FlashButton"
                            Grid.Column="1"
                            Content="Flash firmware"
                            MinWidth="160"
                            Padding="30,14"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="FlashButton_Click"
                            AutomationProperties.Name="Flash firmware" />
                </Grid>

                <Border Grid.Row="1"
                        Height="1"
                        Margin="0,22,0,18"
                        Background="{StaticResource BorderBrush}" />

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Log OpenOCD"
                               Margin="0,0,0,9"
                               FontFamily="Segoe UI Semibold"
                               FontSize="13" />
                    <TextBox x:Name="LogTextBox"
                             Grid.Row="1"
                             Padding="14"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             Foreground="#D7DEE9"
                             Background="#111827"
                             BorderThickness="0"
                             AutomationProperties.Name="Log OpenOCD" />
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center">
            <TextBlock Text="Pembuat: Qimtronics"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"
                       AutomationProperties.Name="Pembuat aplikasi" />
            <TextBlock x:Name="VersionTextBlock"
                       Text="{Binding Version,
                                      RelativeSource={RelativeSource AncestorType=Window},
                                      StringFormat=Versi {0}}"
                       Margin="0,4,0,0"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"
                       AutomationProperties.Name="Versi aplikasi" />
        </StackPanel>
    </Grid>
</Window>
